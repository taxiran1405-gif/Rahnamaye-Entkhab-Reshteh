{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Raw library row",
  "type":"object",
  "required":["raw_sheet","raw_row","raw_values"],
  "properties":{
    "raw_sheet":{"type":"string","minLength":1},
    "raw_row":{"type":"integer","minimum":1},
    "raw_values":{"type":"object","additionalProperties":true},
    "source_id":{"type":["string","null"]},
    "source_locator":{"type":["string","null"]},
    "data_year":{"type":["integer","null"]},
    "data_kind":{"type":["string","null"]},
    "course_type":{"type":["string","null"]},
    "import_batch_id":{"type":"string","minLength":1},
    "imported_at":{"type":"string","minLength":1}
  },
  "additionalProperties":true
}