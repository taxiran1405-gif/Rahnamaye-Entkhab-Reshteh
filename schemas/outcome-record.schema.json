{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"OutcomeRecord",
  "type":"object",
  "required":["candidate_anonymous_id","admission_year","quota_type","actual_quota_rank","accepted"],
  "properties":{
    "candidate_anonymous_id":{"type":"string","minLength":1},
    "admission_year":{"type":"integer"},
    "quota_type":{"type":"string"},
    "region":{"type":["string","null"]},
    "actual_quota_rank":{"type":["integer","null"],"minimum":1},
    "actual_national_rank":{"type":["integer","null"],"minimum":1},
    "choice_code":{"type":["string","null"]},
    "selected_choice_order":{"type":["integer","null"],"minimum":1},
    "accepted":{"type":"boolean"},
    "accepted_program_id":{"type":["string","null"]},
    "accepted_university_id":{"type":["string","null"]},
    "accepted_course_type":{"type":["string","null"]},
    "run_id":{"type":["string","null"]},
    "option_id":{"type":["string","null"]},
    "result_source_id":{"type":["string","null"]},
    "result_evidence_locator":{"type":["string","null"]},
    "observed_at":{"type":["string","null"]},
    "notes":{"type":["string","null"]}
  },
  "additionalProperties":false
}
