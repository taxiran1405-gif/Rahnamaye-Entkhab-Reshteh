{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecommendationCell",
  "type": "object",
  "required": ["cell_id", "target_year", "primary_option", "parallel_options", "verification"],
  "properties": {
    "cell_id": {"type": "string"},
    "target_year": {"type": "integer"},
    "primary_option": {"$ref": "#/$defs/option"},
    "parallel_options": {
      "type": "array",
      "items": {"$ref": "#/$defs/option"}
    },
    "verification": {
      "type": "object",
      "required": ["status", "verified_at"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "REVIEW"]},
        "verified_at": {"type": "string", "format": "date-time"},
        "checks": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["option_id", "program_id", "risk_class", "confidence"],
      "properties": {
        "option_id": {"type": "string"},
        "program_id": {"type": "string"},
        "university_id": {"type": "string"},
        "campus_id": {"type": ["string", "null"]},
        "course_type": {"type": "string"},
        "row_role": {"enum": ["primary", "parallel", "cover"]},
        "admission_probability": {"type": ["object", "null"]},
        "utility_score": {"type": ["number", "null"]},
        "risk_class": {"type": "string"},
        "confidence": {"enum": ["C4", "C3", "C2", "C1", "CX"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
